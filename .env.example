# Copy this file to a new file named  .env  (same folder as app.py) and fill in your own values.
# Never share the real .env file and never commit it.
# Keep each value on the same line as its name and do not add comments after a value.

# ---- AI photo reflection (the website works without it) ----
GEMINI_API_KEY=your_gemini_api_key_here
# Model name. Change it here if Google retires this model.
GEMINI_MODEL=gemini-2.5-flash

# ---- Security: use a long random value. Generate one with:
#      py -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-this-secret-key

# ---- Brand ----
# Name shown in the header, footer and page titles
SITE_NAME=Astro Buddy

# ---- Astro Buddy / astrologer details (shown on Home, Contact and footer) ----
ASTROLOGER_NAME=Dev
# 0001 is a PLACEHOLDER number. Replace it with the real one.
ASTROLOGER_PHONE=0001
# Real Astro Buddy website address, starting with https:// (leave empty until you have it)
ASTROBUDDY_URL=
# Real Instagram profile address, starting with https:// (leave empty until you have it)
ASTROLOGER_INSTAGRAM_URL=

# ---- Payments (optional) ----
RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
REPORT_PRICE_INR=199
# true = demo payment button (no money). Set to false when real payments are live.
DEMO_PAYMENT_ENABLED=true

# ---- Other ----
# Uploaded photos are removed after this many days (0 = never remove automatically)
PHOTO_RETENTION_DAYS=30
FLASK_DEBUG=0
